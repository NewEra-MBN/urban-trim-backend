generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Tenant {
  id Int @id @default(autoincrement())
  name String
  email String @unique
  password String
  isEmailVerfied Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff Staff[]
  service Service[]
  booking Booking[]
  token Token[]
}


model Staff {
  id Int @id @default(autoincrement())
  name String
  email String @unique
  role String
  tenantId Int
  tenant Tenant @relation(fields: [tenantId], references: [id])
}


model Service {
  id Int @id @default(autoincrement())
  name String
  price Int

  tenantId Int
  tenant Tenant @relation(fields: [tenantId], references: [id])
}


model Booking {
  id Int @id @default(autoincrement())
  date DateTime
  customer String
  status String

  tenantId Int
  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model Token {
  id Int @id @default(autoincrement())
  token String
  type TokenType
  expires DateTime
  blacklisted Boolean
  createdAt DateTime @default(now())
  tenantId Int
  tenant Tenant @relation(fields: [tenantId], references: [id])
}


enum Role{
  OWNER
  STAFF 
  ASSISTANT
  RECEPTIONIST
  MANAGER
}

enum TokenType {
  ACCESS
  REFRESH
  RESET_PASSWORD
  VERIFY_EMAIL
}

